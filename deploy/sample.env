ENVIRONMENT=localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=DEBUG
LOG_FORMAT="%(asctime)s - %(levelname)s - %(funcName)s():%(lineno)d - %(message)s"
LOG_TO_STDOUT=0
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com

MAIL_SMTP_SERVER=
MAIL_FROM_ADDRESS=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_SECURITY=STARTTLS
MAIL_SMTP_TIMEOUT=15
